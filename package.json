{
  "name": "task-board",
  "version": "1.0.0",
  "description": "テスト用のタスク管理アプリ (Express + SQLite)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
